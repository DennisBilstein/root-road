{
  "name": "root-road",
  "version": "1.0.0",
  "private": true,
  "license": "(MIT AND CC-BY-4.0)",
  "description": "Root Road – lokale Lernplattform aus dem HTML-Original",
  "scripts": {
    "test": "playwright test",
    "test:labs": "node scripts/run-learning-checks.mjs",
    "audit:learning": "node scripts/validate-learning-release.mjs",
    "build:experts": "node scripts/build-experts.mjs",
    "build": "node scripts/build-css-bundle.mjs && node scripts/build-lesson-videos.mjs && node scripts/build-syntax-glossary.mjs && node scripts/build-puzzles.mjs && node scripts/build-experts.mjs --cached && node scripts/build-action-names.mjs && node scripts/build-prerender.mjs",
    "verify:prerender": "node scripts/build-prerender.mjs --verify",
    "verify:videos": "node scripts/build-lesson-videos.mjs --verify",
    "verify:glossary": "node scripts/build-syntax-glossary.mjs --verify",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "db:backup": "node scripts/db-backup.mjs backup",
    "db:restore": "node scripts/db-backup.mjs restore",
    "verify:puzzles": "node scripts/build-puzzles.mjs --verify",
    "dev": "node server.mjs",
    "start": "node server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "acorn": "^8.19.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "nodemailer": "^10.4.0"
  }
}
